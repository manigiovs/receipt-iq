# MediSked development configuration
# Copy to .env.local or configure these values in the hosting environment.

EXPO_PUBLIC_API_URL=http://localhost/medisked/backend/api/v1

MEDISKED_DB_HOST=127.0.0.1
MEDISKED_DB_NAME=medisked_db
MEDISKED_DB_USER=replace_with_local_user
MEDISKED_DB_PASSWORD=replace_with_local_password

MEDISKED_APP_ENV=development
MEDISKED_ALLOWED_ORIGINS=http://localhost:8081
MEDISKED_SESSION_SECRET=replace_with_a_long_random_value
MEDISKED_AI_PROVIDER=replace_with_provider
MEDISKED_AI_API_KEY=replace_with_server_side_key
